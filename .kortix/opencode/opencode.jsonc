{
  // Epic Tech AI — local + Machine
  // Brand: https://github.com/epictechai · https://x.com/EpicTechAI
  // Set key: opencode auth login  (never put keys in git)
  "$schema": "https://opencode.ai/config.json",
  "theme": "system",
  "username": "Epic Tech AI",
  "default_agent": "epic",

  // Local defaults (OpenAI). Change in UI or here if you use another provider.
  "model": "openai/gpt-4.1",
  "small_model": "openai/gpt-4.1-mini",

  "permission": "allow",

  "compaction": {
    "auto": true,
    "tail_turns": 6,
    "prune": true
  },

  "tool_output": {
    "max_lines": 4000,
    "max_bytes": 102400
  },

  "instructions": ["AGENTS.md"],

  "skills": {
    "paths": [
      "skills",
      "skills/GENERAL-KNOWLEDGE-WORKER"
    ]
  },

  "agent": {
    "epic": { "model": "openai/gpt-4.1" },
    "architect": { "model": "openai/gpt-4.1" },
    "builder": { "model": "openai/gpt-4.1-mini" },
    "researcher": { "model": "openai/gpt-4.1" },
    "critic": { "model": "openai/gpt-4.1-mini" },
    "ops": { "model": "openai/gpt-4.1-mini" },
    "designer": { "model": "openai/gpt-4.1-mini" },
    "writer": { "model": "openai/gpt-4.1-mini" },
    "analyst": { "model": "openai/gpt-4.1-mini" },
    "counsel": { "model": "openai/gpt-4.1" },
    "creator": { "model": "openai/gpt-4.1-mini" },
    "seller": { "model": "openai/gpt-4.1-mini" },
    "product": { "model": "openai/gpt-4.1-mini" },
    "explore": { "model": "openai/gpt-4.1-mini" },
    "general": { "model": "openai/gpt-4.1-mini" },
    "plan": { "model": "openai/gpt-4.1" },
    "build": { "model": "openai/gpt-4.1-mini" },
    "memory-reflector": { "model": "openai/gpt-4.1-mini" }
  }
}
