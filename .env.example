# Epic Tech AI — example environment variables
# Copy to .env and fill values LOCALLY. Never commit .env.
# Prefer: opencode auth login  (stores credentials outside the repo)

# Model providers (pick what you use)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# Optional tools
# TAVILY_API_KEY=
# FIRECRAWL_API_KEY=
# SERPER_API_KEY=
# REPLICATE_API_TOKEN=
# ELEVENLABS_API_KEY=

# Machine / Kortix (set in dashboard, not here)
# STRIPE_API_KEY=
